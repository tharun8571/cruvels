{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "LLM_PROVIDER": "openrouter",
    "LLM_MODEL": "moonshotai/kimi-k2.5",
    "EMBEDDING_MODEL": "BAAI/bge-small-en-v1.5"
  }
}
