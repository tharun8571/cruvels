{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*\\.(js|css|html|ico|png|jpg|svg|woff2?))",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "LLM_PROVIDER": "openrouter",
    "LLM_MODEL": "moonshotai/kimi-k2.5",
    "EMBEDDING_PROVIDER": "huggingface-api",
    "EMBEDDING_MODEL": "BAAI/bge-small-en-v1.5"
  }
}
