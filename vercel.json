{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "env": {
    "LLM_PROVIDER": "openrouter",
    "LLM_MODEL": "moonshotai/kimi-k2.5",
    "EMBEDDING_PROVIDER": "huggingface-api",
    "EMBEDDING_MODEL": "BAAI/bge-small-en-v1.5"
  }
}
